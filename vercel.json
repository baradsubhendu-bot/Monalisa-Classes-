{
  "version": 2,
  "builds": [
    {
      "src": "admin.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/admin.js"
    },
    {
      "src": "/admin.js",
      "dest": "/admin.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
